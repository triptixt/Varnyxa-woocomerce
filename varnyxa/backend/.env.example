# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:your_password@127.0.0.1:5433/varnyxa_db

# Security & Authentication
SECRET_KEY=generate_a_secure_random_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PayYantra Payment Gateway (Hosted Checkout V3)
# UAT Base URL: https://payin-api-uat.payyantra.com | Production: https://payin-api.payyantra.com
PAYYANTRA_BASE_URL=https://payin-api-uat.payyantra.com
PAYYANTRA_CLIENT_ID=
PAYYANTRA_CLIENT_SECRET=
PAYYANTRA_RETURN_URL=http://localhost:5174/payment/payyantra/callback
PAYYANTRA_NOTIFY_URL=http://localhost:8000/api/payments/payyantra/webhook
PAYYANTRA_API_VERSION=2024-01-01
PAYYANTRA_TEST_MODE=false

# Store Settings
STORE_CURRENCY=INR
STORE_CURRENCY_SYMBOL=₹
FREE_SHIPPING_THRESHOLD=1499.0
STANDARD_SHIPPING_FEE=99.0
DEFAULT_GST_PERCENT=12.0

# Admin Provisioning Key for Initial Admin Setup
ADMIN_PROVISION_KEY=generate_a_secure_admin_provision_secret


# Newsletter & Transactional Email Delivery (SMTP)
# If not configured, subscriptions succeed in database without pretending emails were dispatched
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=club@varnyxa.com
EMAILS_FROM_NAME=VARNYXA Club
